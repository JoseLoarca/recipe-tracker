# Copy this file to .env and fill in your own values.
# This is a self-hosted, single-household instance — nothing here is shared
# with any other deployment of this project.

# --- PostgreSQL ---
POSTGRES_USER=recipe_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recipe_tracker
DATABASE_URL=postgresql+psycopg://recipe_tracker:change-me@postgres:5432/recipe_tracker

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (must be running natively on the host, NOT in Docker — see docs/adr/0004) ---
# macOS/Windows (Docker Desktop): use host.docker.internal
# Linux: usually also host.docker.internal via the extra_hosts entry in docker-compose.yml,
#        or fall back to your docker0 bridge address (commonly 172.17.0.1) if that doesn't resolve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b-mlx

# --- Telegram ---
# Create your own bot via @BotFather on Telegram (free) and paste the token below.
TELEGRAM_BOT_TOKEN=

# --- USDA FoodData Central ---
# Free API key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# --- Internal service-to-service auth ---
# Random string shared only between the bot/worker and the backend API.
INTERNAL_API_KEY=change-me

# --- Web session cookie ---
# Only set to true once you've put HTTPS in front of this stack (reverse proxy,
# Tailscale HTTPS, etc). Left false by default since docker-compose.yml serves
# plain HTTP out of the box — a Secure cookie would be silently dropped by
# browsers and login would appear broken.
SESSION_COOKIE_SECURE=false

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
